# Copy to .env and fill in. Never commit .env.
SPOTIFY_CLIENT_ID=
ANTHROPIC_API_KEY=
# teacher (Anthropic API) or veri (fine-tuned model on a Veri deployment)
MODEL=teacher
TEACHER_MODEL=claude-sonnet-4-6
VERI_API_KEY=
VERI_DEP_ID=
# Optional: secret iCal URL for calendar context
ICAL_URL=
# Optional: default location if the browser gives no GPS fix
DEFAULT_LAT=34.0689
DEFAULT_LON=-118.4452
